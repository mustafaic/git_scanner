# Bu dosyayi deploy/.env olarak kopyalayip degerleri doldurun.
# deploy/.env git'e GIRMEZ (kok .gitignore: .env, .env.*).

POSTGRES_USER=scanner
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=scanner

# GitHub.com icin varsayilan; GHES icin https://<host>/api/v3
GITHUB_API_BASE_URL=https://api.github.com

# Bos birakilirsa orchestrator "iskelet modda" calisir (discovery/sync
# devre disi, healthcheck/job-queue/watchdog normal calisir).
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# deploy/secrets/ altina koydugunuz dosyanin CONTAINER ICI yolu (bkz.
# deploy/secrets/README.md). Ornek: /run/secrets/github_app_private_key.pem
GITHUB_APP_PRIVATE_KEY_PATH=

LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=60
DEBOUNCE_WINDOW_SECONDS=20
DAILY_JOBS_INTERVAL_HOURS=24
# master_prompt.md 3.3/4.6: bu sureden daha eski bir KEV/EPSS senkronu
# varsa, Hat B basarili olsa da HICBIR bulgu RESOLVED olmaz.
ADVISORY_MAX_AGE_SECONDS=172800

# Bos = heartbeat kapali (varsayilan, guvenli). Sadece sirket ici bir
# izleyiciye (ornegin kendi barindirdiginiz Healthchecks.io/Uptime Kuma)
# isaret etmeli - internetteki SaaS DEGIL (master_prompt.md kural 12).
HEARTBEAT_URL=
HEARTBEAT_STALE_THRESHOLD_SECONDS=1800
WATCHDOG_CHECK_INTERVAL_SECONDS=60
